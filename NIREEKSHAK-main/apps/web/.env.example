# =====================================================
# NIREEKSHAK Frontend Environment Variables Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# =====================================================

# CARTO Basemap Authentication Key (Optional, for high-resolution vector tiles)
# Leave empty or provide your CARTO API key
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here
CARTO_API_KEY=your_carto_api_key_here

# Backend FastAPI Core Service URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
